# ─────────────────────────────────────────────────────────────
# Aaroh Server — environment template
# Copy this file to `.env` and adjust values. NEVER commit your real .env.
# ─────────────────────────────────────────────────────────────

# ── Database (PostgreSQL + PostGIS) ──────────────────────────
POSTGRES_USER=aaroh
POSTGRES_PASSWORD=aaroh
POSTGRES_DB=aaroh

# Connection string used when you run commands from your HOST machine
# (e.g. `npm run migrate:up` inside ./api, or running the API locally).
# It uses `localhost` because the DB's port is published to your machine.
DATABASE_URL=postgres://aaroh:aaroh@localhost:5432/aaroh

# NOTE: Inside docker-compose, the API container reaches the database at
# host `db` (the service name), NOT localhost. That value is injected for
# you in docker-compose.yml, so you don't need to change anything here.

# ── API (Node / Express) ─────────────────────────────────────
NODE_ENV=development
PORT=3000

# Where the API finds the Python AI service.
# On your host: http://localhost:8000   |   Inside compose: http://ai:8000 (auto-set)
AI_SERVICE_URL=http://localhost:8000
