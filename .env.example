# ─────────────────────────────────────────────────────────────
# Aaroh Server — environment template
# Copy this file to `.env` and adjust values. NEVER commit your real .env.
# ─────────────────────────────────────────────────────────────

# ── Database (PostgreSQL + PostGIS) ──────────────────────────
POSTGRES_USER=aaroh
POSTGRES_PASSWORD=aaroh
POSTGRES_DB=aaroh

# Host-side port the database container is published on.
# Deliberately 5433, not 5432: if PostgreSQL is also installed natively on your
# machine it already owns 5432, and Windows will happily let both listen — then
# route your connections to the WRONG one, giving a misleading
# "password authentication failed for user aaroh". 5433 sidesteps that entirely.
DB_HOST_PORT=5433

# Connection string used when you run commands from your HOST machine
# (e.g. `npm run migrate:up` inside ./api, or running the API locally).
# Note the port matches DB_HOST_PORT above.
DATABASE_URL=postgres://aaroh:aaroh@localhost:5433/aaroh

# NOTE: Inside docker-compose, the API container reaches the database at
# host `db` on port 5432 (the service name and its internal port), NOT localhost.
# That value is injected for you in docker-compose.yml — nothing to change here.

# ── API (Node / Express) ─────────────────────────────────────
NODE_ENV=development
PORT=3000

# Where the API finds the Python AI service.
# On your host: http://localhost:8000   |   Inside compose: http://ai:8000 (auto-set)
AI_SERVICE_URL=http://localhost:8000
