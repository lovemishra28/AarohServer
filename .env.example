# ─────────────────────────────────────────────────────────────
# Aaroh Server — environment template
# Copy this file to `.env` and adjust values. NEVER commit your real .env.
# ─────────────────────────────────────────────────────────────

# ── Database (PostgreSQL + PostGIS) ──────────────────────────
POSTGRES_USER=aaroh
POSTGRES_PASSWORD=aaroh
POSTGRES_DB=aaroh

# Host-side port the database container is published on.
# Deliberately 5433, not 5432: if PostgreSQL is also installed natively on your
# machine it already owns 5432, and Windows will happily let both listen — then
# route your connections to the WRONG one, giving a misleading
# "password authentication failed for user aaroh". 5433 sidesteps that entirely.
DB_HOST_PORT=5433

# Connection string used when you run commands from your HOST machine
# (e.g. `npm run migrate:up` inside ./api, or running the API locally).
# Note the port matches DB_HOST_PORT above.
DATABASE_URL=postgres://aaroh:aaroh@localhost:5433/aaroh

# NOTE: Inside docker-compose, the API container reaches the database at
# host `db` on port 5432 (the service name and its internal port), NOT localhost.
# That value is injected for you in docker-compose.yml — nothing to change here.

# ── API (Node / Express) ─────────────────────────────────────
NODE_ENV=development
PORT=3000

# Where the API finds the Python AI service.
# On your host: http://localhost:8000   |   Inside compose: http://ai:8000 (auto-set)
AI_SERVICE_URL=http://localhost:8000

# ── Auth: tokens ─────────────────────────────────────────────
# HS256 secret for access JWTs. MUST be replaced in any real deployment.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=dev-insecure-secret-change-me-please
JWT_ACCESS_TTL_S=900
JWT_REFRESH_TTL_S=2592000

# ── Auth: phone OTP (dev stub — no SMS provider) ──────────────
# While OTP_DEV_CODE is set, every phone login code is this fixed value and is
# also returned in the response as `dev_code` outside production. Set it EMPTY to
# generate random 6-digit codes (then read them from the server log).
OTP_DEV_CODE=000000
OTP_TTL_S=300
OTP_MAX_ATTEMPTS=5
OTP_MAX_PER_HOUR=5

# ── Auth: Google Sign-In ─────────────────────────────────────
# The **Web application** OAuth client ID from Google Cloud Console
# (APIs & Services → Credentials). Looks like:
#   1234567890-abcdefghijklmnop.apps.googleusercontent.com
# The mobile app is configured with this SAME id, so it is the `aud` claim of the
# ID tokens this server verifies. Leave empty and POST /v1/auth/google answers
# 503 GOOGLE_NOT_CONFIGURED instead of trusting unverifiable tokens.
#
# The matching client-side variable is EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID in
# AAROH-Client/.env — the two MUST be the same value.
GOOGLE_WEB_CLIENT_ID=
# Rarely needed: comma-separated additionahttp://<laptop-ip>:3000l client IDs to accept as `aud`.
GOOGLE_EXTRA_AUDIENCES=

# ── Auth: email + password ───────────────────────────────────
# scrypt work factor (cost = log2(N)). 15 ≈ 100–200 ms and ~128 MB per hash.
# Each +1 doubles time AND memory. Stored hashes record their own parameters, so
# changing this only affects newly-created passwords.
PASSWORD_SCRYPT_COST=15

# ── Auth: email OTP (verification / login codes / password reset) ──
# console = write the email to the server log instead of sending it (dev default,
# no provider account needed). smtp = actually send, using the SMTP_* values.
MAIL_TRANSPORT=console
MAIL_FROM=Aaroh <no-reply@aaroh.local>
EMAIL_OTP_TTL_S=600
EMAIL_OTP_MAX_PER_HOUR=5

# Only read when MAIL_TRANSPORT=smtp.
# SMTP_SECURE=true  → implicit TLS, use SMTP_PORT=465
# SMTP_SECURE=false → plain connect then STARTTLS, use SMTP_PORT=587
# For Gmail, SMTP_PASS must be a 16-character App Password, not your account
# password (App Passwords require 2-Step Verification to be enabled).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
