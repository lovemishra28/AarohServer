# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration (MongoDB)
MONGODB_URI=mongodb://127.0.0.1:27017/aaroh_agriculture_db

# JSON Web Token (JWT) Configuration
JWT_SECRET=aaroh_super_secret_jwt_key_agriculture_2026_change_in_production
JWT_EXPIRE=30d

# Google OAuth2 (Android Client ID)
GOOGLE_CLIENT_ID=your_android_google_oauth_client_id.apps.googleusercontent.com

# Mobile OTP Configuration
OTP_TTL_MINUTES=5
OTP_LENGTH=6
DEFAULT_DEV_OTP=123456

# SMS Provider Integration (e.g. twilio, fast2sms, mock)
SMS_PROVIDER=mock
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
