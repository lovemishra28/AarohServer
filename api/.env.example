# Aaroh API — environment configuration (§6.1)
# Copy to `.env` for local dev. Every variable is validated at boot by
# src/config/env.ts; the app fails loudly if a value is malformed. All values
# below are the built-in defaults, shown so you know what you can override.

# ── Runtime ─────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000

# ── Datastore ─────────────────────────────────────────────────────────────
# Host-published Postgres port is 5433 (NOT 5432 — avoids colliding with a
# native Postgres install; see docker-compose.yml). Inside compose the API
# talks to db:5432 and this is overridden.
DATABASE_URL=postgres://aaroh:aaroh@localhost:5433/aaroh

# ── AI gateway (private Python inference service, §6.3) ─────────────────────
AI_SERVICE_URL=http://localhost:8000
# Synchronous /recommend budget in ms (inference is slower than a health ping).
AI_REQUEST_TIMEOUT_MS=8000

# ── Auth (§6.1) ───────────────────────────────────────────────────────────
# HS256 signing secret (node:crypto, no library). MUST be overridden in
# production; minimum length 16. TTLs are integer SECONDS.
JWT_SECRET=dev-insecure-secret-change-me-please
JWT_ACCESS_TTL_S=900        # 15 minutes
JWT_REFRESH_TTL_S=2592000   # 30 days

# ── OTP (dev stub — no SMS provider wired yet) ──────────────────────────────
# When OTP_DEV_CODE is set, every request issues this fixed code (handy for
# curl/tests). Set it empty to generate + log a random 6-digit code instead.
OTP_DEV_CODE=000000
OTP_TTL_S=300               # 5 minutes
OTP_MAX_ATTEMPTS=5
OTP_MAX_PER_HOUR=5          # per-phone rate limit
