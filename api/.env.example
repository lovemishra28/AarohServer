# Aaroh API — local settings. Copy to api/.env (that exact path; loaded by
# src/config/env.ts on boot). Real environment variables always win over this file,
# so containers and CI are unaffected by whatever you put here.
#
# Every setting below has a working default — this file is only needed for Google
# sign-in and real email. See src/config/env.ts for the full validated list.

# ── Core ──────────────────────────────────────────────────────────────────────
# Host-published database port is 5433, not 5432 (see docker-compose.yml).
DATABASE_URL=postgres://aaroh:aaroh@localhost:5433/aaroh
AI_SERVICE_URL=http://localhost:8000

# Override in production. The default is deliberately insecure so local dev runs.
# JWT_SECRET=change-me-to-32-random-bytes

# ── Google Sign-In (POST /v1/auth/google) ─────────────────────────────────────
# The **Web application** OAuth client ID from https://console.cloud.google.com
# → APIs & Services → Credentials. The mobile app must send the SAME value as
# EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID in AAROH-Client/.env: the server requires the ID
# token's `aud` to equal this string, and that check is what makes the token proof of
# identity rather than a bearer string anyone could mint elsewhere.
#
# Leave it empty and /v1/auth/google answers 503 GOOGLE_NOT_CONFIGURED — the app then
# shows "Google sign-in is not set up on the server yet" instead of crashing.
GOOGLE_WEB_CLIENT_ID=

# ── Email ─────────────────────────────────────────────────────────────────────
# console (default) writes each message to the API log and, outside production, also
# returns `dev_code` in the response — so email codes and password reset are fully
# testable with no mail provider. Switch to smtp for real delivery.
MAIL_TRANSPORT=console
MAIL_FROM=Aaroh <no-reply@aaroh.local>

# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false          # false = STARTTLS on 587; true = implicit TLS on 465
# SMTP_USER=you@gmail.com
# SMTP_PASS=                 # Gmail requires a 16-char App Password, not your password
