{
  "name": "aaroh-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Aaroh backend API (Express) — the product surface / BFF.",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "migrate:up": "node-pg-migrate up -m ../database/migrations",
    "migrate:down": "node-pg-migrate down -m ../database/migrations",
    "migrate:create": "node-pg-migrate create -m ../database/migrations --"
  },
  "dependencies": {
    "express": "^4.19.2",
    "node-pg-migrate": "^7.6.1",
    "pg": "^8.12.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.1",
    "@types/express": "^4.17.21",
    "@types/node": "^22.5.4",
    "@types/pg": "^8.11.8",
    "@types/supertest": "^6.0.2",
    "eslint": "^9.9.1",
    "supertest": "^7.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.5.4",
    "typescript-eslint": "^8.4.0",
    "vitest": "^2.0.5"
  }
}
